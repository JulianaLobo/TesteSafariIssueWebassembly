@page "/teste"

<PageTitle>Teste Video</PageTitle>

<h1>Vídeo Teste:</h1>

@* Main Section *@
<div id="main-section-home" class="mw-100 w-100 vh-100 overflow-hidden section bg-white-red bg-img-home">
    <video id="video-main-home" class="w-100 h-100 video-diy" autoplay loop muted playsinline poster="/assets/imgs/bg-home-loading.webp">
        <source src="lib/home-video.webm" type="video/webm" />
        <source src="lib/home-video-safari.mp4" type="video/mp4" />
    </video>
</div>
@* End Main Section *@

<script>
        document.addEventListener('DOMContentLoaded', function() {
        var video = document.getElementById('video-main-home');
        video.muted = true;
        video.play().catch(function(e) {
            console.log('Autoplay blocked:', e);
        });
    });
</script>